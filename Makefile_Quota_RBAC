.PHONY: apply-myapp-serviceaccount-and-deployment
apply-myapp-serviceaccount-and-deployment: ## Apply myapp ServiceAccount and Deployment
	@$(MAKE) -f Makefile_Quota_RBAC apply-a-serviceaccount-per-app-with-automountserviceaccounttoken-false-in-team-alpha-namespace
	@$(MAKE) -f Makefile_Quota_RBAC apply-myapp-deployment-that-uses-myapp-servicecccount-in-team-alpha-namespace

.PHONY: apply-a-default-serviceaccount-with-automountserviceaccounttoken-false-in-team-alpha-namespace
apply-a-default-serviceaccount-with-automountserviceaccounttoken-false-in-team-alpha-namespace: check-kubectl ## Disable token automount for default ServiceAccount in team-alpha
	@test -f $(DEFAULT_SA_TEAM_ALPHA_FILE) || (echo "Missing file: $(DEFAULT_SA_TEAM_ALPHA_FILE)" && exit 1)
	@printf '$(CYAN)%s$(RESET)\n' "Apply default ServiceAccount hardening for team-alpha"
	@kubectl apply -f $(DEFAULT_SA_TEAM_ALPHA_FILE)

.PHONY: apply-a-serviceaccount-per-app-with-automountserviceaccounttoken-true-in-team-alpha-namespace
apply-a-serviceaccount-per-app-with-automountserviceaccounttoken-true-in-team-alpha-namespace: check-kubectl ## Apply ServiceAccount for deploy-bot
	@test -f $(DEPLOY_BOT_SERVICEACCOUNT_FILE) || (echo "Missing file: $(DEPLOY_BOT_SERVICEACCOUNT_FILE)" && exit 1)
	@printf '$(CYAN)%s$(RESET)\n' "Apply ServiceAccount for deploy-bot"
