	@$(MAKE) -f Makefile_Quota_RBAC apply-rolebinding-between-deployments-role-and-serviceaccount-in-namespace-team-alpha

# Verify ServiceAccounts and Deployment
# For myapp:
.PHONY: verify-myapp-serviceaccount-and-deployment
verify-myapp-serviceaccount-and-deployment: check-kubectl ## Verify myapp SA and Deployment exist and match expectations
	@printf '$(CYAN)%s$(RESET)\n' "Verify myapp ServiceAccount in $(NAMESPACE_TEAM_ALPHA)"
	@kubectl -n $(NAMESPACE_TEAM_ALPHA) get sa myapp >/dev/null 2>&1 || (echo "ERROR: ServiceAccount myapp not found in $(NAMESPACE_TEAM_ALPHA)" && exit 1)

	@printf '$(CYAN)%s$(RESET)\n' "Verify myapp Deployment in $(NAMESPACE_TEAM_ALPHA)"
	@kubectl -n $(NAMESPACE_TEAM_ALPHA) get deploy myapp >/dev/null 2>&1 || (echo "ERROR: Deployment myapp not found in $(NAMESPACE_TEAM_ALPHA)" && exit 1)

	@printf '$(CYAN)%s$(RESET)\n' "Verify myapp Deployment uses ServiceAccount myapp"
	@SA=$$(kubectl -n $(NAMESPACE_TEAM_ALPHA) get deploy myapp -o jsonpath='{.spec.template.spec.serviceAccountName}'); \
	if [ "$$SA" != "myapp" ]; then \
	  echo "ERROR: myapp Deployment is not using ServiceAccount 'myapp' (found: $$SA)"; \
	  exit 1; \
	else \
	  echo "OK: myapp Deployment uses ServiceAccount 'myapp'"; \
	fi

# Verify ServiceAccounts and Deployment
# For deploy-bot:
.PHONY: verify-deploy-bot-rbac
verify-deploy-bot-rbac: check-kubectl ## Verify deploy-bot SA, Role, and RoleBinding exist
	@printf '$(CYAN)%s$(RESET)\n' "Verify deploy-bot ServiceAccount"
	@kubectl -n $(NAMESPACE_TEAM_ALPHA) get sa deploy-bot >/dev/null 2>&1 || (echo "ERROR: ServiceAccount deploy-bot not found in $(NAMESPACE_TEAM_ALPHA)" && exit 1)

	@printf '$(CYAN)%s$(RESET)\n' "Verify deploy-bot Role"
	@kubectl -n $(NAMESPACE_TEAM_ALPHA) get role deployment-restarter >/dev/null 2>&1 || (echo "ERROR: Role deployment-restarter not found in $(NAMESPACE_TEAM_ALPHA)" && exit 1)

	@printf '$(CYAN)%s$(RESET)\n' "Verify deploy-bot RoleBinding"
	@kubectl -n $(NAMESPACE_TEAM_ALPHA) get rolebinding deploy-bot-binding >/dev/null 2>&1 || (echo "ERROR: RoleBinding deploy-bot-binding not found in $(NAMESPACE_TEAM_ALPHA)" && exit 1)

# Verify default ServiceAccount hardening
# You already apply:
# 	apply-a-default-serviceaccount-with-automountserviceaccounttoken-false-in-team-alpha-namespace
# 	but you don’t yet verify that the default ServiceAccount in team-alpha actually has automountServiceAccountToken: false
.PHONY: verify-default-serviceaccount-hardening-team-alpha
verify-default-serviceaccount-hardening-team-alpha: check-kubectl ## Verify default SA in team-alpha has automountServiceAccountToken=false
	@printf '$(CYAN)%s$(RESET)\n' "Verify default ServiceAccount hardening in $(NAMESPACE_TEAM_ALPHA)"
	@AUTOMOUNT=$$(kubectl -n $(NAMESPACE_TEAM_ALPHA) get sa default -o jsonpath='{.automountServiceAccountToken}'); \
	if [ "$$AUTOMOUNT" != "false" ]; then \
	  echo "ERROR: default ServiceAccount in $(NAMESPACE_TEAM_ALPHA) is not hardened (automountServiceAccountToken=$$AUTOMOUNT)"; \
	  exit 1; \
	else \
	  echo "OK: default ServiceAccount in $(NAMESPACE_TEAM_ALPHA) has automountServiceAccountToken=false"; \
	fi
# -----------------------------------------------------------------------------------
# ------------------------------ SECTION 7: RBAC AUDIT TARGETS ----------------------
# -----------------------------------------------------------------------------------
# ----------------------------------------------------------------------------------------------------------------
#						Auditing What an Identity Can Actually Do
#					1. Never trust your own YAML
#					2. Make targets for RBAC auditing
#  Note: kubectl auth can-i is the official way to test whether a given subject can perform an action, 
#		 and --list prints all effective permissions for that subject. rbac-lookup and who-can are krew 
#        plugins that help you answer “what is bound to this identity?” and “who can perform this action?” 
#        respectively.
#
# #   Examples:
# 1. make rbac-can-deploy-bot-delete-deployments
# → “Can deploy-bot delete deployments in team-alpha?”
#
# 2. make rbac-list-deploy-bot-permissions
# → “Full effective permission list for deploy-bot in team-alpha”.
#
# 3. make rbac-can-dev-group-write-secrets
# → “Does team-alpha-developers group have secret-write access?”.
#
# 4. rbac-cross-namespace-leak-check
# → “Cross-namespace leak check — deploy-bot get pods in team-beta must be no”.
#
# 5. rbac-install-krew-plugins, rbac-lookup-deploy-bot, rbac-who-can-delete-deployments-team-alpha
# → “Install rbac-lookup / who-can and use them to see bindings and who can delete deployments”.
#
# rbac-audit-checklist
# → One command to run your whole RBAC audit sequence in one go.
# ----------------------------------------------------------------------------------------------------------------
.PHONY: rbac-can-deploy-bot-delete-deployments
rbac-can-deploy-bot-delete-deployments: check-kubectl ## Assert deploy-bot CANNOT delete deployments in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(DEPLOY_BOT_SA) must NOT be able to delete deployments in $(TEAM_ALPHA_NS)"
	@OUT=$$(kubectl auth can-i delete deployments \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_ALPHA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "ERROR: deploy-bot CAN delete deployments in $(TEAM_ALPHA_NS) (violates least privilege)"; \
	  exit 1; \
	else \
	  echo "OK: deploy-bot cannot delete deployments in $(TEAM_ALPHA_NS)"; \
	fi

.PHONY: rbac-list-deploy-bot-permissions
rbac-list-deploy-bot-permissions: check-kubectl ## List all effective permissions for deploy-bot in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "List effective permissions for $(DEPLOY_BOT_SA) in $(TEAM_ALPHA_NS)"
	@kubectl auth can-i --list \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_ALPHA_NS) || (echo "kubectl auth can-i --list failed" && exit 1)

.PHONY: rbac-can-dev-group-write-secrets
rbac-can-dev-group-write-secrets: check-kubectl ## Assert team-alpha-developers CANNOT create secrets in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(TEAM_ALPHA_DEV_GROUP) must NOT be able to create secrets in $(TEAM_ALPHA_NS)"
	@OUT=$$(kubectl auth can-i create secrets \
		--as=someone@example.com \
		--as-group=$(TEAM_ALPHA_DEV_GROUP) \
		-n $(TEAM_ALPHA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "ERROR: $(TEAM_ALPHA_DEV_GROUP) CAN create secrets in $(TEAM_ALPHA_NS) (too much privilege)"; \
	  exit 1; \
	else \
	  echo "OK: $(TEAM_ALPHA_DEV_GROUP) cannot create secrets in $(TEAM_ALPHA_NS)"; \
	fi

.PHONY: rbac-cross-namespace-leak-check
rbac-cross-namespace-leak-check: check-kubectl ## Assert deploy-bot CANNOT get pods in team-beta
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(DEPLOY_BOT_SA) must NOT be able to get pods in $(TEAM_BETA_NS)"
	@OUT=$$(kubectl auth can-i get pods \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_BETA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "ERROR: $(DEPLOY_BOT_SA) CAN get pods in $(TEAM_BETA_NS) (namespace isolation broken)"; \
	  exit 1; \
	else \
	  echo "OK: $(DEPLOY_BOT_SA) cannot get pods in $(TEAM_BETA_NS)"; \
	fi

.PHONY: rbac-install-krew-plugins
rbac-install-krew-plugins: check-kubectl ## Install RBAC audit plugins via krew (rbac-lookup, who-can) if not already installed
	@kubectl krew list >/dev/null 2>&1 || (echo "krew is not installed or not configured" && exit 1)
	@printf '$(CYAN)%s$(RESET)\n' "Ensure rbac-lookup and who-can are installed via krew"
	@kubectl krew list | grep -q '^rbac-lookup$$' || kubectl krew install rbac-lookup
	@kubectl krew list | grep -q '^who-can$$' || kubectl krew install who-can

.PHONY: rbac-lookup-deploy-bot
rbac-lookup-deploy-bot: check-kubectl rbac-install-krew-plugins ## Show RBAC bindings for deploy-bot ServiceAccount across the cluster
	@printf '$(CYAN)%s$(RESET)\n' "rbac-lookup for deploy-bot ServiceAccount"
	@kubectl rbac-lookup deploy-bot --kind serviceaccount || (echo "kubectl rbac-lookup failed" && exit 1)

.PHONY: rbac-who-can-delete-deployments-team-alpha
rbac-who-can-delete-deployments-team-alpha: check-kubectl rbac-install-krew-plugins ## Show who can delete deployments in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "who-can delete deployments in $(TEAM_ALPHA_NS)"
	@kubectl who-can delete deployments -n $(TEAM_ALPHA_NS) || (echo "kubectl who-can failed" && exit 1)

# Here’s how you can add “assert allow” checks so your RBAC audit suite verifies both:
# 		Permissions that must be denied (namespace isolation, secret write).
# 		Permissions that must be allowed (deploy-bot rollout operations).
# This gives you:
# 		3 assert-allow checks: get/list/patch on deployments.
# 		3 assert-deny checks: delete deployments, secret write, cross-namespace pods.
# 		3 inspection commands: --list, rbac-lookup, who-can.
#
# assert-allow means: “check that this identity is allowed to do this one specific thing, and fail if it is not.”
# 	For your deploy-bot, the allow checks mean:
# 		It can get deployments in team-alpha.
# 		It can list deployments in team-alpha.
# 		It can patch deployments in team-alpha.

# 	That matches its job: it is allowed to interact with deployments enough to trigger rollouts, but not delete them or change unrelated things.

# 	Why it matters
# 	Think of it like a permission test:
# 		Assert allow = “this should be permitted.”
# 		Assert deny = “this should be blocked.”

# Assert: deploy-bot CAN get deployments
.PHONY: rbac-assert-deploy-bot-can-get-deployments
rbac-assert-deploy-bot-can-get-deployments: check-kubectl ## Assert deploy-bot CAN get deployments in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(DEPLOY_BOT_SA) must be able to GET deployments in $(TEAM_ALPHA_NS)"
	@OUT=$$(kubectl auth can-i get deployments \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_ALPHA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "OK: $(DEPLOY_BOT_SA) can GET deployments in $(TEAM_ALPHA_NS)"; \
	else \
	  echo "ERROR: $(DEPLOY_BOT_SA) CANNOT GET deployments in $(TEAM_ALPHA_NS) (rollout role too restrictive)"; \
	  exit 1; \
	fi

#Assert: deploy-bot CAN list deployments
.PHONY: rbac-assert-deploy-bot-can-list-deployments
rbac-assert-deploy-bot-can-list-deployments: check-kubectl ## Assert deploy-bot CAN list deployments in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(DEPLOY_BOT_SA) must be able to LIST deployments in $(TEAM_ALPHA_NS)"
	@OUT=$$(kubectl auth can-i list deployments \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_ALPHA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "OK: $(DEPLOY_BOT_SA) can LIST deployments in $(TEAM_ALPHA_NS)"; \
	else \
	  echo "ERROR: $(DEPLOY_BOT_SA) CANNOT LIST deployments in $(TEAM_ALPHA_NS) (rollout role too restrictive)"; \
	  exit 1; \
	fi

Assert: deploy-bot CAN patch deployments
.PHONY: rbac-assert-deploy-bot-can-patch-deployments
rbac-assert-deploy-bot-can-patch-deployments: check-kubectl ## Assert deploy-bot CAN patch deployments in team-alpha
	@printf '$(CYAN)%s$(RESET)\n' "Assert: $(DEPLOY_BOT_SA) must be able to PATCH deployments in $(TEAM_ALPHA_NS)"
	@OUT=$$(kubectl auth can-i patch deployments \
		--as=$(DEPLOY_BOT_SA) \
		-n $(TEAM_ALPHA_NS)); \
	echo "$$OUT"; \
	if [ "$$OUT" = "yes" ]; then \
	  echo "OK: $(DEPLOY_BOT_SA) can PATCH deployments in $(TEAM_ALPHA_NS)"; \
	else \
	  echo "ERROR: $(DEPLOY_BOT_SA) CANNOT PATCH deployments in $(TEAM_ALPHA_NS) (cannot trigger rollouts)"; \
	  exit 1; \
	fi

.PHONY: rbac-audit-checklist
rbac-audit-checklist: ## Run the full RBAC audit checklist (assert allow + assert deny)
	@$(MAKE) -f Makefile_Quota_RBAC rbac-assert-deploy-bot-can-get-deployments
	@$(MAKE) -f Makefile_Quota_RBAC rbac-assert-deploy-bot-can-list-deployments
	@$(MAKE) -f Makefile_Quota_RBAC rbac-assert-deploy-bot-can-patch-deployments
	@$(MAKE) -f Makefile_Quota_RBAC rbac-can-deploy-bot-delete-deployments
	@$(MAKE) -f Makefile_Quota_RBAC rbac-list-deploy-bot-permissions
	@$(MAKE) -f Makefile_Quota_RBAC rbac-can-dev-group-write-secrets
	@$(MAKE) -f Makefile_Quota_RBAC rbac-cross-namespace-leak-check
	@$(MAKE) -f Makefile_Quota_RBAC rbac-lookup-deploy-bot
	@$(MAKE) -f Makefile_Quota_RBAC rbac-who-can-delete-deployments-team-alpha

