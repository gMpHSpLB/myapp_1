apply-deployments-rollout-role-that-can-get-list-patch-in-namespace-team-alpha: check-kubectl ## Apply Role for deployment restarter in team-alpha
	@test -f $(DEPLOY_BOT_ROLE_FILE) || (echo "Missing file: $(DEPLOY_BOT_ROLE_FILE)" && exit 1)
